#!/usr/bin/env python3
"""Minimal THOR Thunderstorm stub for the script-collector suites.

This is a LOCAL convenience so the suites run from a bare checkout. The authoritative
implementation is the Go stub CI builds (Nextron-Labs/thunderstorm-stub-server, pinned by
STUB_SERVER_REF in .github/workflows/script-collectors.yml); this file exists only to mirror
its wire and JSONL shapes closely enough that a suite passing here passes there.

Mirroring the JSONL shape is the whole point, not a nicety: an earlier revision logged the
collector's marker body VERBATIM, so `{"type":"begin"}` reached the audit log as
`"type":"begin"`. The Go stub rewrites that to `"type":"collection_marker","marker":"begin"`.
Assertions written against this file's shape therefore passed locally and could not pass in
CI. Keep every field name below identical to main.go's collectionMarkerLog / logEntry.

Contract:
  --port N --uploads-dir DIR --log-file FILE
  GET  /api/status              -> uptime_seconds, scanned_samples, avg_scan_time_milliseconds,
                                   queued_async_requests
  GET  /api/info                -> thor_version, yara_version, stub_mode, rules_dir
  POST /api/checkAsync?source=S -> 200; store the file part under uploads-dir; append a
  POST /api/check?source=S         "THOR finding" JSONL line (meta/subject shape)
  POST /api/collection          -> 200 for begin (answers a scan_id) / end / interrupted;
                                   400 on invalid JSON or an unknown marker type; 405 otherwise
"""
import argparse
import hashlib
import json
import os
import re
import socket
import sys
import threading
import time
import uuid
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

ap = argparse.ArgumentParser()
ap.add_argument('--port', type=int, required=True)
ap.add_argument('--uploads-dir', required=True)
ap.add_argument('--log-file', required=True)
args = ap.parse_args()
os.makedirs(args.uploads_dir, exist_ok=True)

LOCK = threading.Lock()
SCANNED = 0
START_TIME = time.time()
HOSTNAME = socket.gethostname()


def audit(obj):
    """One JSONL line per entry, serialized under the lock like the Go stub's writeLogEntry."""
    with LOCK:
        with open(args.log_file, 'a', encoding='utf-8', errors='replace') as f:
            f.write(json.dumps(obj, ensure_ascii=False) + '\n')


def now_rfc3339():
    return time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())


def parse_multipart(body, ctype):
    m = re.search(r'boundary="?([^";,]+)"?', ctype or '')
    if not m:
        return None, body
    bnd = ('--' + m.group(1)).encode()
    for part in body.split(bnd):
        if b'\r\n\r\n' not in part and b'\n\n' not in part:
            continue
        sep = b'\r\n\r\n' if b'\r\n\r\n' in part else b'\n\n'
        head, _, payload = part.partition(sep)
        fn = re.search(rb'filename="([^"]*)"', head)
        if fn is None:
            continue
        payload = payload[:-2] if payload.endswith(b'\r\n') else payload
        payload = payload[:-1] if payload.endswith(b'\n') else payload
        return fn.group(1).decode('utf-8', 'replace'), payload
    return None, body


def first_bytes(data):
    return data[:16]


def first_bytes_ascii(data):
    return ''.join(chr(c) if 32 <= c < 127 else '.' for c in first_bytes(data))


class H(BaseHTTPRequestHandler):
    protocol_version = 'HTTP/1.1'

    def log_message(self, *a):
        sys.stderr.write(('%s - ' % self.address_string()) + (a[0] % a[1:]) + '\n')

    def _reply(self, code, obj):
        data = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header('Content-Type', 'application/json')
        self.send_header('Content-Length', str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def _plain(self, code, text):
        data = (text + '\n').encode()
        self.send_response(code)
        self.send_header('Content-Type', 'text/plain; charset=utf-8')
        self.send_header('Content-Length', str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        path, _, _query = self.path.partition('?')
        if path == '/api/status':
            self._reply(200, {
                'uptime_seconds': int(time.time() - START_TIME),
                'scanned_samples': SCANNED,
                'avg_scan_time_milliseconds': 0,
                'queued_async_requests': 0,
            })
        elif path == '/api/info':
            self._reply(200, {
                'thor_version': '10.6.0',
                'yara_version': '',
                'stub_mode': True,
                'rules_dir': '',
            })
        else:
            self._reply(404, {'error': 'not found'})

    def do_POST(self):
        global SCANNED
        length = int(self.headers.get('Content-Length') or 0)
        body = self.rfile.read(length) if length else b''
        path, _, query = self.path.partition('?')
        if path in ('/api/checkAsync', '/api/check'):
            self._upload(path, body, query)
        elif path == '/api/collection':
            self._collection(body)
        else:
            self._reply(404, {'error': 'not found'})

    def _upload(self, path, body, query):
        global SCANNED
        client_path, payload = parse_multipart(body, self.headers.get('Content-Type'))
        client_path = client_path or ''
        source = ''
        for kv in query.split('&'):
            k, _, v = kv.partition('=')
            if k == 'source':
                from urllib.parse import unquote_plus
                source = unquote_plus(v)
        with LOCK:
            SCANNED += 1
        # The Go stub stores <per-upload uuid><ext> and reports that as subject.path.
        ext = os.path.splitext(client_path)[1]
        stored = os.path.join(args.uploads_dir, uuid.uuid4().hex + ext)
        with open(stored, 'wb') as f:
            f.write(payload)
        audit({
            'type': 'THOR finding',
            'meta': {
                'time': now_rfc3339(),
                'level': 'Info',
                'module': 'ThunderstormTestServer',
                'scan_id': '',
                'hostname': HOSTNAME,
            },
            'message': 'No match',
            'subject': {
                'type': 'file',
                'path': stored,
                'client_filename': client_path,
                'exists': 'yes',
                'extension': ext,
                'hashes': {
                    'sha256': hashlib.sha256(payload).hexdigest(),
                    'sha1': hashlib.sha1(payload).hexdigest(),
                    'md5': hashlib.md5(payload).hexdigest(),
                },
                'first_bytes': {
                    'hex': first_bytes(payload).hex(),
                    'ascii': first_bytes_ascii(payload),
                },
                'size': len(payload),
                'source': source,
            },
            'score': 0,
            'reasons': [],
            'reason_count': 0,
            'log_version': 'v3.0.0',
            'endpoint': path,
            'query': query,
        })
        self._reply(200, {'status': 'ok'})

    def _collection(self, body):
        try:
            req = json.loads(body.decode('utf-8', 'replace'))
            if not isinstance(req, dict):
                raise ValueError('not an object')
        except Exception:
            self._plain(400, 'invalid JSON')
            return
        marker = req.get('type')
        if marker not in ('begin', 'end', 'interrupted'):
            self._plain(400, 'unknown marker type')
            return
        # The audit line is the SERVER's record, not the request body: 'type' is always
        # 'collection_marker' and the marker name lives in 'marker'.
        entry = {
            'type': 'collection_marker',
            'marker': marker,
            'source': req.get('source'),
            'collector': req.get('collector'),
        }
        if marker == 'begin':
            scan_id = str(uuid.uuid4())
        else:
            scan_id = req.get('scan_id') or ''
        if scan_id:
            entry['scan_id'] = scan_id
        if req.get('timestamp') is not None:
            entry['timestamp'] = req.get('timestamp')
        if marker in ('end', 'interrupted') and isinstance(req.get('stats'), dict):
            entry['stats'] = req.get('stats')
        if marker == 'interrupted' and req.get('reason'):
            entry['reason'] = req.get('reason')
        entry['time'] = now_rfc3339()
        audit(entry)
        if marker == 'begin':
            self._reply(200, {'scan_id': scan_id})
        else:
            self._reply(200, {'ok': True})


ThreadingHTTPServer(('127.0.0.1', args.port), H).serve_forever()
